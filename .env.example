# letterflow environment example
#
# IMPORTANT: letterflow does NOT read secrets from environment variables or
# .env files in normal use. API keys and SMTP passwords are entered in the app
# and stored in your operating system's secure credential manager.
#
# This file exists only to document optional, NON-SECRET development defaults.
# Never put real API keys or passwords here, and never commit a real .env file.

# Optional: override the default AI base URL shown in Settings (dev only).
# VITE_DEFAULT_AI_BASE_URL=https://api.openai.com/v1

# Optional: override the default AI model shown in Settings (dev only).
# VITE_DEFAULT_AI_MODEL=gpt-4o-mini

# Optional: host for Tauri mobile/remote dev (advanced).
# TAURI_DEV_HOST=
